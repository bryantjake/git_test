# Garmin Activity Tracker Environment Configuration

# Flask secret key (change this in production!)
SECRET_KEY=your-secret-key-change-in-production

# Database URL
# Local development:
DATABASE_URL=postgresql://username:password@localhost:5432/garmin_tracker

# For Heroku/Railway/etc, the DATABASE_URL will be automatically set
# Make sure to use postgresql:// not postgres:// (the app handles the conversion)

# Optional: Debug mode (set to False in production)
FLASK_DEBUG=True
FLASK_ENV=development

# Garmin Connect Integration
# Encryption key for storing Garmin session tokens securely
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GARMIN_ENCRYPTION_KEY=your-encryption-key-here
