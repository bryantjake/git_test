# NFL GeoGuessr Environment Configuration

# Flask secret key (change this in production!)
SECRET_KEY=your-secret-key-change-in-production

# Database URL (defaults to SQLite if not set)
# DATABASE_URL=postgresql://username:password@localhost:5432/nfl_guessr
# DATABASE_URL=sqlite:///nfl_guessr.db

# Optional: Debug mode (set to False in production)
FLASK_DEBUG=True
FLASK_ENV=development
